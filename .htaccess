# Nonaktifkan directory listing
Options -Indexes

# Proteksi file sensitif
<FilesMatch "\.(sql|log|env|bak|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Blokir akses langsung ke folder config
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses ke config/
    RewriteRule ^config/ - [F,L]

    # Redirect root ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^$ /siakad/index.php [R=302,L]
</IfModule>

# Karakter encoding default
AddDefaultCharset UTF-8

# ── Security Headers ──
<IfModule mod_headers.c>
    # Cegah clickjacking (halaman tidak boleh di-frame situs lain)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Cegah MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Batasi informasi referrer yang dikirim ke situs lain
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS — aktifkan hanya jika situs sudah full HTTPS
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Batasi fitur browser
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Sembunyikan versi server (fingerprinting)
<IfModule mod_headers.c>
    ServerSignature Off
</IfModule>